<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - PharmaDesk</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/app.css" asp-append-version="true" />
    
    <style>
        :root {
            --sidebar-width: 260px;
            --sidebar-bg: #0b1120;           /* Deep Charcoal */
            --sidebar-hover: #1e293b;        /* Lighter slate for hover */
            --sidebar-active-bg: #4f46e5;    /* Solid Indigo for active */
            --text-main: #0f172a;            /* Dark slate for main content */
            --text-muted: #64748b;
            --border-color: #e2e8f0;
            --topbar-height: 64px;
        }

        body {
            background-color: #f8fafc !important; /* Soft light background for content */
            font-family: 'Inter', system-ui, -apple-system, sans-serif;
            overflow-x: hidden;
            color: var(--text-main);
        }

        /* =========================================
           PREMIUM DARK SIDEBAR
           ========================================= */
        .sidebar {
            width: var(--sidebar-width) !important;
            background: var(--sidebar-bg) !important;
            border-right: 1px solid rgba(255, 255, 255, 0.05) !important;
            position: fixed;
            top: 0; bottom: 0; left: 0;
            z-index: 1040;
            display: flex;
            flex-direction: column;
            box-shadow: 4px 0 24px rgba(0, 0, 0, 0.15);
        }

        .offcanvas-header {
            border-bottom: 1px solid rgba(255, 255, 255, 0.05) !important;
            padding: 20px 24px !important;
        }
        .offcanvas-title {
            font-weight: 800; letter-spacing: -0.5px;
            background: linear-gradient(to right, #818cf8, #f472b6);
            -webkit-background-clip: text; -webkit-text-fill-color: transparent;
        }

        .sidebar-body {
            flex: 1;
            display: flex;
            flex-direction: column;
            padding: 0 !important;
            overflow-y: auto;
        }

        .sidebar-brand {
            padding: 24px;
        }
        .brand-name {
            display: block; font-size: 1.35rem; font-weight: 800;
            color: #fff; letter-spacing: -0.5px;
        }
        .brand-tag {
            display: block; font-size: 0.7rem; color: #94a3b8;
            text-transform: uppercase; letter-spacing: 1.5px; font-weight: 600;
            margin-top: 2px;
        }

        .sidebar-nav {
            padding: 10px 16px;
            flex: 1;
        }
        .sidebar-nav .nav-link {
            display: flex; align-items: center; gap: 12px;
            padding: 12px 16px;
            margin-bottom: 4px;
            border-radius: 10px;
            color: #94a3b8 !important;
            font-size: 0.9rem;
            font-weight: 500;
            text-decoration: none;
            transition: all 0.2s ease;
            position: relative;
        }
        
        .sidebar-nav .nav-link:hover {
            background: var(--sidebar-hover);
            color: #f8fafc !important;
        }
        
        .sidebar-nav .nav-link.active {
            background: linear-gradient(90deg, rgba(79, 70, 229, 0.2) 0%, rgba(79, 70, 229, 0.05) 100%) !important;
            color: #e0e7ff !important;
            font-weight: 600;
            border-left: 3px solid #6366f1;
            box-shadow: inset 0 0 20px rgba(99, 102, 241, 0.1);
        }

        .sidebar-nav .nav-link svg {
            width: 20px; height: 20px; opacity: 0.6;
            transition: all 0.2s;
        }
        .sidebar-nav .nav-link:hover svg, 
        .sidebar-nav .nav-link.active svg {
            opacity: 1;
            color: #a5b4fc;
        }

        .sidebar-footer {
            padding: 20px 24px;
            font-size: 0.75rem;
            border-top: 1px solid rgba(255, 255, 255, 0.05);
            color: #64748b;
        }

        /* =========================================
           MAIN WRAPPER
           ========================================= */
        .main-wrapper {
            margin-left: var(--sidebar-width);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        /* =========================================
           TOPBAR (Dark Glass Effect) - FIXED TEXT COLORS
           ========================================= */
        .topbar {
            height: var(--topbar-height);
            background: #0b1120 !important; /* Same as sidebar */
            border-bottom: 1px solid rgba(255, 255, 255, 0.05);
            padding: 0 24px;
            position: sticky;
            top: 0;
            z-index: 1030;
        }

        /* Breadcrumb Text Colors */
        .breadcrumb {
            background: transparent !important;
            padding: 0 !important;
            margin: 0 !important;
            font-size: 0.85rem;
            font-weight: 500;
        }
        .breadcrumb-item a {
            color: #94a3b8 !important; /* Light gray */
            text-decoration: none;
            transition: color 0.2s;
        }
        .breadcrumb-item a:hover { 
            color: #a5b4fc !important; /* Indigo highlight on hover */
        }
        .breadcrumb-item.active { 
            color: #f8fafc !important; /* Pure white */
            font-weight: 600; 
        }
        .breadcrumb-item + .breadcrumb-item::before {
            color: #475569 !important; /* Slash divider color */
        }

        /* Topbar Version Text */
        .topbar-meta span.text-muted {
            color: #64748b !important; 
            font-size: 0.8rem;
        }

        /* Mobile hamburger icon */
        .topbar .btn-outline-secondary {
            color: #94a3b8 !important;
            border-color: rgba(255,255,255,0.1) !important;
        }
        .topbar .btn-outline-secondary:hover {
            background: rgba(255,255,255,0.05) !important;
            color: #fff !important;
        }

        /* =========================================
           CONTENT AREA
           ========================================= */
        .content-area {
            flex: 1;
            padding: 32px;
            background: #f1f5f9;
        }

        /* =========================================
           TOPBAR USER PROFILE
           ========================================= */
        .topbar-meta .user-profile-btn {
            background: rgba(255, 255, 255, 0.05) !important;
            border: 1px solid rgba(255, 255, 255, 0.1) !important;
            color: #f8fafc !important;
            border-radius: 8px !important;
            padding: 6px 12px !important;
            font-weight: 600;
            font-size: 0.85rem;
            transition: all 0.2s;
        }
        .topbar-meta .user-profile-btn:hover {
            background: rgba(255, 255, 255, 0.1) !important;
            border-color: rgba(255, 255, 255, 0.2) !important;
        }
        .topbar-meta .user-profile-btn .avatar-circle {
            background: linear-gradient(135deg, #6366f1, #a855f7);
        }

        .dropdown-menu {
            border-radius: 12px !important;
            border: 1px solid var(--border-color) !important;
            box-shadow: 0 10px 25px -5px rgba(0,0,0,0.2) !important;
            padding: 8px !important;
            margin-top: 8px !important;
        }
        .dropdown-item {
            border-radius: 8px !important;
            padding: 8px 12px !important;
            font-size: 0.9rem;
            font-weight: 500;
            color: var(--text-main) !important;
        }
        .dropdown-item:hover {
            background: #f1f5f9 !important;
            color: var(--text-main) !important;
        }

        /* =========================================
           RESPONSIVE (MOBILE)
           ========================================= */
        @@media (max-width: 767.98px) {
            .sidebar {
                transform: translateX(-100%);
                transition: transform 0.3s ease-in-out;
            }
            .sidebar.show {
                transform: translateX(0);
            }
            .main-wrapper {
                margin-left: 0;
            }
            .content-area {
                padding: 20px 16px;
            }
            .topbar {
                padding: 0 16px;
            }
        }
    </style>
</head>
<body>
    <!-- Sidebar -->
    <div class="offcanvas-md offcanvas-start sidebar" tabindex="-1" id="sidebarPanel" aria-labelledby="sidebarPanelLabel">
        <div class="offcanvas-header d-flex d-md-none">
            <h5 class="offcanvas-title" id="sidebarPanelLabel">PharmaDesk</h5>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas" data-bs-target="#sidebarPanel" aria-label="Close"></button>
        </div>
        <div class="offcanvas-body sidebar-body">
            <div class="sidebar-brand d-none d-md-block">
                <span class="brand-name">PharmaDesk</span>
                <span class="brand-tag">Pharmacy Management</span>
            </div>
            
            <nav class="nav flex-column sidebar-nav">
                <!-- Dashboard -->
                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" ? "active" : "")" asp-controller="Home" asp-action="Index">
                    <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"></path></svg>
                    Dashboard
                </a>

                @if (User.HasClaim("permission", "Users.View"))
                {
                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Users" ? "active" : "")" asp-controller="Users" asp-action="Index">
                        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"></path></svg>
                        Users
                    </a>
                }
                @if (User.HasClaim("permission", "Roles.View"))
                {
                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Roles" ? "active" : "")" asp-controller="Roles" asp-action="Index">
                        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path></svg>
                        Roles
                    </a>
                }
                @if (User.HasClaim("permission", "Branches.View"))
                {
                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Branches" ? "active" : "")" asp-controller="Branches" asp-action="Index">
                        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path></svg>
                        Branches
                    </a>
                }
                @if (User.HasClaim("permission", "Tenant.Manage"))
                {
                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Tenant" ? "active" : "")" asp-controller="Tenant" asp-action="Index">
                        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path></svg>
                        Pharmacy Profile
                    </a>
                }
                @if (User.HasClaim("permission", "Medicines.View"))
                {
                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Medicines" ? "active" : "")" asp-controller="Medicines" asp-action="Index">
                        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z"></path></svg>
                        Medicines
                    </a>
                }
                @if (User.HasClaim("permission", "Suppliers.View"))
                {
                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Suppliers" ? "active" : "")" asp-controller="Suppliers" asp-action="Index">
                        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M8 14v3m4-3v3m4-3v3M3 21h18M3 10h18M3 7l9-4 9 4M4 10h16v11H4V10z"></path></svg>
                        Suppliers
                    </a>
                }
                @if (User.HasClaim("permission", "Customers.View"))
                {
                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Customers" ? "active" : "")" asp-controller="Customers" asp-action="Index">
                        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path></svg>
                        Customers
                    </a>
                }
                @if (User.HasClaim("permission", "Purchases.View"))
                {
                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Purchases" ? "active" : "")" asp-controller="Purchases" asp-action="Index">
                        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z"></path></svg>
                        Purchases
                    </a>
                }
                @if (User.HasClaim("permission", "Inventory.View"))
                {
                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Inventory" ? "active" : "")" asp-controller="Inventory" asp-action="StockOverview">
                        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"></path></svg>
                        Inventory
                    </a>
                }
                @if (User.HasClaim("permission", "Sales.View"))
                {
                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Sales" ? "active" : "")" asp-controller="Sales" asp-action="Index">
                        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                        Sales
                    </a>
                }
                @if (User.HasClaim("permission", "Returns.View"))
                {
                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Returns" ? "active" : "")" asp-controller="Returns" asp-action="SalesReturns">
                        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path></svg>
                        Returns
                    </a>
                }
                @if (User.HasClaim("permission", "Payments.View"))
                {
                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Payments" ? "active" : "")" asp-controller="Payments" asp-action="Receivables">
                        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"></path></svg>
                        Due &amp; Payments
                    </a>
                }
                @if (User.HasClaim("permission", "Expenses.View"))
                {
                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Expenses" ? "active" : "")" asp-controller="Expenses" asp-action="Index">
                        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17 9V7a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2m2 4h10a2 2 0 002-2v-6a2 2 0 00-2-2H9a2 2 0 00-2 2v6a2 2 0 002 2zm7-5a2 2 0 11-4 0 2 2 0 014 0z"></path></svg>
                        Expenses
                    </a>
                }
                @if (User.HasClaim("permission", "CashDrawer.View"))
                {
                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "CashDrawer" ? "active" : "")" asp-controller="CashDrawer" asp-action="Index">
                        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17 9V7a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2m2 4h10a2 2 0 002-2v-6a2 2 0 00-2-2H9a2 2 0 00-2 2v6a2 2 0 002 2zm7-5a2 2 0 11-4 0 2 2 0 014 0z"></path></svg>
                        Cash Drawer
                    </a>
                }
                @if (User.HasClaim("permission", "Reports.View"))
                {
                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Reports" ? "active" : "")" asp-controller="Reports" asp-action="SalesReport">
                        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path></svg>
                        Reports
                    </a>
                }
                @if (User.HasClaim("permission", "Backup.View"))
                {
                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Backup" ? "active" : "")" asp-controller="Backup" asp-action="Index">
                        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 7v10c0 2.21 3.582 4 8 4s8-1.79 8-4V7M4 7c0 2.21 3.582 4 8 4s8-1.79 8-4M4 7c0-2.21 3.582-4 8-4s8 1.79 8 4m0 5c0 2.21-3.582 4-8 4s-8-1.79-8-4"></path></svg>
                        Backup
                    </a>
                }
            </nav>
            
            <div class="sidebar-footer">
                PharmaDesk &copy; @DateTime.Now.Year
            </div>
        </div>
    </div>

    <!-- Main Content Wrapper -->
    <div class="main-wrapper">
        <!-- Topbar -->
        <header class="topbar d-flex align-items-center justify-content-between">
            <div class="d-flex align-items-center gap-3">
                <button class="btn btn-sm btn-outline-secondary d-md-none" type="button" data-bs-toggle="offcanvas" data-bs-target="#sidebarPanel" aria-controls="sidebarPanel">
                    <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16"></path></svg>
                </button>
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb mb-0">
                        @await RenderSectionAsync("Breadcrumb", required: false)
                    </ol>
                </nav>
            </div>
            
            <div class="topbar-meta d-flex align-items-center gap-3">
                <span class="text-muted small d-none d-sm-block">PharmaDesk v0.15.0</span>
                
                @if (User.Identity?.IsAuthenticated == true)
                {
                    @await Component.InvokeAsync("NotificationBell")
                    
                    <div class="dropdown">
                        <button class="btn btn-sm user-profile-btn dropdown-toggle d-flex align-items-center gap-2" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                            <div class="avatar-circle text-white rounded-circle d-flex align-items-center justify-content-center" style="width: 24px; height: 24px; font-size: 0.75rem;">
                                @(User.FindFirst(System.Security.Claims.ClaimTypes.GivenName)?.Value?.Substring(0, 1).ToUpper() ?? "U")
                            </div>
                            <span class="d-none d-sm-inline">@User.FindFirst(System.Security.Claims.ClaimTypes.GivenName)?.Value</span>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li><a class="dropdown-item" asp-controller="Account" asp-action="ChangePassword">🔑 Change Password</a></li>
                            <li><hr class="dropdown-divider"></li>
                            <li>
                                <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                                    <button type="submit" class="dropdown-item text-danger">🚪 Logout</button>
                                </form>
                            </li>
                        </ul>
                    </div>
                }
            </div>
        </header>

        <!-- Content Area -->
        <main class="content-area">
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>