@model List<RoleListItemViewModel>
@{
    ViewData["Title"] = "Roles";
}

@section Breadcrumb {
    <li class="breadcrumb-item active" aria-current="page">Roles</li>
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0">Roles</h1>
    @if (User.HasClaim("permission", "Roles.Manage"))
    {
        <a class="btn btn-primary" asp-action="Create">New Role</a>
    }
</div>

<div class="card-metric p-0">
    <table class="table mb-0">
        <thead>
            <tr>
                <th>Name</th>
                <th>Description</th>
                <th>Permissions granted</th>
                <th class="text-end">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var role in Model)
            {
                <tr>
                    <td>@role.Name</td>
                    <td>@role.Description</td>
                    <td>@role.PermissionCount</td>
                    <td class="text-end">
                        @if (User.HasClaim("permission", "Roles.Manage"))
                        {
                            <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@role.Id">Edit</a>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
