@model PurchaseReportViewModel
@{
    ViewData["Title"] = "Purchase Report";
}

@section Breadcrumb {
    <li class="breadcrumb-item active" aria-current="page">Purchase Report</li>
}

<h1 class="h3 mb-4">Purchase Report</h1>

<form method="get" class="mb-3 d-flex gap-2 align-items-end flex-wrap">
    <div>
        <label class="form-label small mb-0">From</label>
        <input type="date" name="fromDate" class="form-control" value="@Model.FromDate.ToString("yyyy-MM-dd")" />
    </div>
    <div>
        <label class="form-label small mb-0">To</label>
        <input type="date" name="toDate" class="form-control" value="@Model.ToDate.ToString("yyyy-MM-dd")" />
    </div>
    <div>
        <label class="form-label small mb-0">Branch</label>
        <select name="branchId" class="form-select">
            <option value="">-- All branches --</option>
            @foreach (var branch in Model.AvailableBranches)
            {
                <option value="@branch.Value" selected="@(Model.BranchId.HasValue && branch.Value == Model.BranchId.Value.ToString())">@branch.Text</option>
            }
        </select>
    </div>
    <div>
        <label class="form-label small mb-0">Supplier</label>
        <select name="supplierId" class="form-select">
            <option value="">-- All suppliers --</option>
            @foreach (var supplier in Model.AvailableSuppliers)
            {
                <option value="@supplier.Value" selected="@(Model.SupplierId.HasValue && supplier.Value == Model.SupplierId.Value.ToString())">@supplier.Text</option>
            }
        </select>
    </div>
    <button type="submit" class="btn btn-outline-secondary">Filter</button>
    <a class="btn btn-outline-secondary" asp-action="PurchaseReport" asp-route-fromDate="@Model.FromDate" asp-route-toDate="@Model.ToDate" asp-route-branchId="@Model.BranchId" asp-route-supplierId="@Model.SupplierId" asp-route-format="csv">Export CSV</a>
</form>

<div class="card-metric p-0">
    <table class="table mb-0">
        <thead>
            <tr>
                <th>Medicine</th>
                <th>Pack Unit</th>
                <th class="text-end">Quantity Purchased</th>
                <th class="text-end">Total Cost</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var row in Model.Rows)
            {
                <tr>
                    <td>@row.MedicineBrandName</td>
                    <td>@row.PackUnitName</td>
                    <td class="text-end">@row.QuantityPacks.ToString("N2")</td>
                    <td class="text-end">@row.TotalCost.ToString("N2")</td>
                </tr>
            }
            @if (!Model.Rows.Any())
            {
                <tr>
                    <td colspan="4" class="text-center text-muted py-4">No purchases in this period.</td>
                </tr>
            }
        </tbody>
        @if (Model.Rows.Any())
        {
            <tfoot>
                <tr class="fw-bold">
                    <td colspan="3">Total Cost</td>
                    <td class="text-end">@Model.TotalCost.ToString("N2")</td>
                </tr>
            </tfoot>
        }
    </table>
</div>
