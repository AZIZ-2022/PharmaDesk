@model List<MedicineListItemViewModel>
@{
    ViewData["Title"] = "Medicines";
    var searchTerm = ViewData["SearchTerm"] as string;
}

@section Breadcrumb {
    <li class="breadcrumb-item active" aria-current="page">Medicines</li>
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0">Medicines</h1>
    <div class="d-flex gap-2">
        @if (User.HasClaim("permission", "Medicines.Manage"))
        {
            <a class="btn btn-outline-secondary" asp-controller="MedicineCategories" asp-action="Index">Categories</a>
            <a class="btn btn-outline-secondary" asp-controller="Manufacturers" asp-action="Index">Manufacturers</a>
            <a class="btn btn-primary" asp-action="Create">New Medicine</a>
        }
    </div>
</div>

<form method="get" class="mb-3" style="max-width: 400px;">
    <div class="input-group">
        <input type="text" name="q" value="@searchTerm" class="form-control" placeholder="Search by brand or generic name..." />
        <button type="submit" class="btn btn-outline-secondary">Search</button>
    </div>
</form>

<div class="card-metric p-0">
    <table class="table mb-0">
        <thead>
            <tr>
                <th>Brand</th>
                <th>Generic</th>
                <th>Strength</th>
                <th>Category</th>
                <th>Manufacturer</th>
                <th>Dosage Form</th>
                <th>Reorder Level</th>
                <th>Status</th>
                <th class="text-end">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var medicine in Model)
            {
                <tr>
                    <td>@medicine.BrandName</td>
                    <td>@medicine.GenericName</td>
                    <td>@medicine.Strength</td>
                    <td>@medicine.CategoryName</td>
                    <td>@medicine.ManufacturerName</td>
                    <td>@medicine.DosageFormName</td>
                    <td>@medicine.ReorderLevel</td>
                    <td>
                        @if (medicine.IsActive)
                        {
                            <span class="badge text-bg-success">Active</span>
                        }
                        else
                        {
                            <span class="badge text-bg-secondary">Deactivated</span>
                        }
                    </td>
                    <td class="text-end">
                        @if (User.HasClaim("permission", "Medicines.Manage"))
                        {
                            <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@medicine.Id">Edit</a>
                            <form asp-action="ToggleActive" asp-route-id="@medicine.Id" method="post" class="d-inline">
                                <button type="submit" class="btn btn-sm @(medicine.IsActive ? "btn-outline-danger" : "btn-outline-success")">
                                    @(medicine.IsActive ? "Deactivate" : "Activate")
                                </button>
                            </form>
                        }
                    </td>
                </tr>
            }
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="9" class="text-center text-muted py-4">No medicines found.</td>
                </tr>
            }
        </tbody>
    </table>
</div>
