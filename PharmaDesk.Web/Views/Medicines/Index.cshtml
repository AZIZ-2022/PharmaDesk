@model List<MedicineListItemViewModel>
@{
    ViewData["Title"] = "Medicines";
    var searchTerm = ViewData["SearchTerm"] as string;
}

@section Breadcrumb {
    <li class="breadcrumb-item active" aria-current="page">Medicines</li>
}

<style>
    .page-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem; flex-wrap: wrap; gap: 10px; }
    .page-title { font-size: 1.5rem; font-weight: 800; color: #0f172a; margin: 0; letter-spacing: -0.5px; }
    
    .btn-premium {
        background: linear-gradient(135deg, #6366f1, #8b5cf6);
        color: #fff !important; border: none; border-radius: 10px; padding: 10px 20px;
        font-weight: 600; font-size: 0.9rem; box-shadow: 0 4px 12px rgba(99, 102, 241, 0.3);
        transition: all 0.2s;
    }
    .btn-premium:hover { transform: translateY(-2px); box-shadow: 0 6px 16px rgba(99, 102, 241, 0.4); }
    
    .btn-secondary-soft {
        background: #ffffff; color: #475569 !important; border: 1px solid #e2e8f0;
        border-radius: 10px; padding: 10px 18px; font-weight: 600; font-size: 0.9rem;
        transition: all 0.2s; text-decoration: none;
    }
    .btn-secondary-soft:hover { background: #f8fafc; border-color: #cbd5e1; color: #0f172a !important; }

    .search-bar {
        max-width: 400px; width: 100%;
    }
    .search-bar .form-control {
        border-radius: 10px 0 0 10px; border: 1.5px solid #e2e8f0; padding: 10px 16px;
        border-right: none;
    }
    .search-bar .form-control:focus { border-color: #8b5cf6; box-shadow: none; }
    .search-bar .btn {
        border-radius: 0 10px 10px 0; border: 1.5px solid #e2e8f0; border-left: none;
        background: #f8fafc; color: #475569; font-weight: 600;
    }
    .search-bar .btn:hover { background: #e2e8f0; }

    .table-custom-wrapper {
        background: #ffffff; border-radius: 16px; border: 1px solid #e2e8f0;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.02); overflow: hidden;
    }
    .table-custom { width: 100%; margin-bottom: 0; border-collapse: collapse; }
    .table-custom thead { background: #f8fafc; }
    .table-custom th {
        font-size: 0.75rem; font-weight: 700; color: #64748b; text-transform: uppercase;
        letter-spacing: 0.5px; padding: 14px 16px; border-bottom: 1px solid #e2e8f0;
        white-space: nowrap;
    }
    .table-custom td {
        padding: 14px 16px; border-bottom: 1px solid #f1f5f9; vertical-align: middle;
        font-size: 0.9rem; color: #334155;
    }
    .table-custom tbody tr { transition: background 0.2s; }
    .table-custom tbody tr:hover { background: #f8fafc; }

    .badge-status {
        padding: 6px 12px; border-radius: 20px; font-size: 0.75rem; font-weight: 600;
        display: inline-flex; align-items: center; gap: 6px;
    }
    .badge-status.active { background: #ecfdf5; color: #059669; border: 1px solid #a7f3d0; }
    .badge-status.inactive { background: #f1f5f9; color: #64748b; border: 1px solid #e2e8f0; }
    .badge-status::before { content: ''; width: 6px; height: 6px; border-radius: 50%; background: currentColor; }

    .btn-action {
        padding: 6px 12px; font-size: 0.8rem; font-weight: 600; border-radius: 8px;
        text-decoration: none; transition: all 0.2s; border: 1px solid transparent;
    }
    .btn-edit { background: #f1f5f9; color: #475569 !important; }
    .btn-edit:hover { background: #e2e8f0; color: #0f172a !important; }
    .btn-danger-soft { background: #fef2f2; color: #dc2626 !important; }
    .btn-danger-soft:hover { background: #fee2e2; }
    .btn-success-soft { background: #ecfdf5; color: #059669 !important; }
    .btn-success-soft:hover { background: #d1fae5; }

    .empty-state { padding: 60px 20px; text-align: center; color: #64748b; }
    .empty-state svg { width: 48px; height: 48px; color: #cbd5e1; margin-bottom: 16px; }
    .empty-state h3 { font-size: 1.1rem; font-weight: 700; color: #334155; margin-bottom: 8px; }
</style>

<div class="page-header">
    <div>
        <h1 class="page-title">Medicines Inventory</h1>
        <p class="text-muted small mb-0 mt-1">Manage all medicines and pharmaceutical products.</p>
    </div>
    
    @if (User.HasClaim("permission", "Medicines.Manage"))
    {
        <div class="d-flex gap-2 flex-wrap">
            <a class="btn-secondary-soft" asp-controller="MedicineCategories" asp-action="Index">Categories</a>
            <a class="btn-secondary-soft" asp-controller="Manufacturers" asp-action="Index">Manufacturers</a>
            <a class="btn-premium" asp-action="Create">+ New Medicine</a>
        </div>
    }
</div>

<form method="get" class="search-bar mb-4">
    <div class="input-group">
        <input type="text" name="q" value="@searchTerm" class="form-control" placeholder="🔍 Search by brand or generic name..." />
        <button type="submit" class="btn">Search</button>
    </div>
</form>

<div class="table-custom-wrapper">
    @if (!Model.Any())
    {
        <div class="empty-state">
            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z"></path></svg>
            <h3>No Medicines Found</h3>
            <p>Get started by adding your first medicine to inventory.</p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table-custom">
                <thead>
                    <tr>
                        <th>Brand</th>
                        <th>Generic</th>
                        <th>Strength</th>
                        <th>Category</th>
                        <th>Manufacturer</th>
                        <th>Dosage</th>
                        <th>Reorder</th>
                        <th>Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var medicine in Model)
                    {
                        <tr>
                            <td class="fw-bold text-dark">@medicine.BrandName</td>
                            <td class="text-muted">@medicine.GenericName</td>
                            <td>@medicine.Strength</td>
                            <td><span class="badge bg-light text-dark border fw-normal">@medicine.CategoryName</span></td>
                            <td class="text-muted">@medicine.ManufacturerName</td>
                            <td>@medicine.DosageFormName</td>
                            <td class="fw-semibold">@medicine.ReorderLevel</td>
                            <td>
                                @if (medicine.IsActive)
                                {
                                    <span class="badge-status active">Active</span>
                                }
                                else
                                {
                                    <span class="badge-status inactive">Deactivated</span>
                                }
                            </td>
                            <td class="text-end">
                                <div class="d-flex justify-content-end gap-2">
                                    @if (User.HasClaim("permission", "Medicines.Manage"))
                                    {
                                        <a class="btn-action btn-edit" asp-action="Edit" asp-route-id="@medicine.Id">Edit</a>
                                        <form asp-action="ToggleActive" asp-route-id="@medicine.Id" method="post" class="d-inline m-0">
                                            <button type="submit" class="btn-action @(medicine.IsActive ? "btn-danger-soft" : "btn-success-soft")">
                                                @(medicine.IsActive ? "Deactivate" : "Activate")
                                            </button>
                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>