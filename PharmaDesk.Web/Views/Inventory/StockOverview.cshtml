@model List<StockOverviewItemViewModel>
@{
    ViewData["Title"] = "Stock Overview";
    var branches = ViewData["AvailableBranches"] as List<SelectListItem> ?? new();
    var selectedBranchId = ViewData["SelectedBranchId"] as long?;
}

@section Breadcrumb {
    <li class="breadcrumb-item active" aria-current="page">Stock Overview</li>
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0">Stock Overview</h1>
    <div class="d-flex gap-2">
        <a class="btn btn-outline-secondary" asp-action="Batches">All Batches</a>
        <a class="btn btn-outline-secondary" asp-action="ExpiryAlerts">Expiry Alerts</a>
    </div>
</div>

<form method="get" class="mb-3" style="max-width: 300px;">
    <select name="branchId" class="form-select" onchange="this.form.submit()">
        <option value="">-- All branches --</option>
        @foreach (var branch in branches)
        {
            <option value="@branch.Value" selected="@(selectedBranchId.HasValue && branch.Value == selectedBranchId.Value.ToString())">@branch.Text</option>
        }
    </select>
</form>

<div class="card-metric p-0">
    <table class="table mb-0">
        <thead>
            <tr>
                <th>Medicine</th>
                <th>Generic Name</th>
                <th class="text-end">Remaining (base units)</th>
                <th class="text-end">Reorder Level</th>
                <th>Status</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.BrandName</td>
                    <td>@item.GenericName</td>
                    <td class="text-end">@item.QuantityRemaining.ToString("N2")</td>
                    <td class="text-end">@item.ReorderLevel.ToString("N2")</td>
                    <td>
                        @if (item.Status == "Out of Stock")
                        {
                            <span class="badge text-bg-danger">Out of Stock</span>
                        }
                        else if (item.Status == "Low")
                        {
                            <span class="badge text-bg-warning">Low</span>
                        }
                        else
                        {
                            <span class="badge text-bg-success">OK</span>
                        }
                    </td>
                </tr>
            }
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="5" class="text-center text-muted py-4">No medicines found.</td>
                </tr>
            }
        </tbody>
    </table>
</div>
