@model List<BatchListItemViewModel>
@{
    ViewData["Title"] = "Expiry Alerts";
    var thresholdDays = ViewData["ThresholdDays"] as int? ?? 90;
}

@section Breadcrumb {
    <li class="breadcrumb-item"><a asp-action="StockOverview" class="text-decoration-none text-muted">Stock Overview</a></li>
    <li class="breadcrumb-item active" aria-current="page">Expiry Alerts</li>
}

<style>
    .alert-info-banner {
        background: linear-gradient(135deg, #fffbeb, #fef3c7);
        border: 1px solid #fde68a; border-radius: 12px;
        padding: 16px 20px; margin-bottom: 1.5rem;
        display: flex; align-items: center; gap: 12px;
        color: #92400e; font-size: 0.9rem;
    }

    .table-custom-wrapper {
        background: #ffffff; border-radius: 16px; border: 1px solid #e2e8f0;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.02); overflow: hidden;
    }
    .table-custom { width: 100%; margin-bottom: 0; border-collapse: collapse; }
    .table-custom thead { background: #f8fafc; }
    .table-custom th {
        font-size: 0.75rem; font-weight: 700; color: #64748b; text-transform: uppercase;
        letter-spacing: 0.5px; padding: 14px 16px; border-bottom: 1px solid #e2e8f0;
        white-space: nowrap;
    }
    .table-custom td {
        padding: 14px 16px; border-bottom: 1px solid #f1f5f9; vertical-align: middle;
        font-size: 0.9rem; color: #334155;
    }
    .table-custom tbody tr { transition: background 0.2s; }
    .table-custom tbody tr:hover { background: #f8fafc; }
    .table-custom tbody tr.expired-row { background: #fef2f2 !important; }
    .table-custom tbody tr.expired-row:hover { background: #fee2e2 !important; }
    .table-custom tbody tr.expiring-row { background: #fffbeb !important; }
    .table-custom tbody tr.expiring-row:hover { background: #fef3c7 !important; }

    .batch-number { font-family: 'Courier New', monospace; font-weight: 700; font-size: 0.85rem; color: #475569; }

    .days-badge {
        display: inline-flex; align-items: center; padding: 6px 12px;
        border-radius: 20px; font-size: 0.75rem; font-weight: 700; gap: 6px;
    }
    .days-badge.expired { background: #fef2f2; color: #dc2626; border: 1px solid #fecaca; }
    .days-badge.critical { background: #fffbeb; color: #d97706; border: 1px solid #fde68a; }
    .days-badge.warning { background: #eff6ff; color: #2563eb; border: 1px solid #bfdbfe; }

    .btn-adjust {
        padding: 6px 14px; font-size: 0.8rem; font-weight: 600; border-radius: 8px;
        text-decoration: none; transition: all 0.2s;
        background: #f1f5f9; color: #475569 !important; border: 1px solid #e2e8f0;
    }
    .btn-adjust:hover { background: #e2e8f0; color: #0f172a !important; }

    .empty-state { padding: 60px 20px; text-align: center; color: #64748b; }
    .empty-state svg { width: 48px; height: 48px; color: #cbd5e1; margin-bottom: 16px; }
    .empty-state h3 { font-size: 1.1rem; font-weight: 700; color: #334155; margin-bottom: 8px; }
</style>

<div class="mb-4">
    <h1 class="h3 fw-bold mb-1" style="color:#0f172a;">Expiry Alerts</h1>
    <p class="text-muted small mb-0">Batches expiring within <strong>@thresholdDays days</strong> or already expired.</p>
</div>

<div class="alert-info-banner">
    <svg width="24" height="24" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path></svg>
    <div>
        <strong>Attention Required:</strong> Please take action on these batches (return, discount, or dispose).
    </div>
</div>

<div class="table-custom-wrapper">
    @if (!Model.Any())
    {
        <div class="empty-state">
            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
            <h3>All Clear! 🎉</h3>
            <p>No batches are expired or nearing expiry within @thresholdDays days.</p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table-custom">
                <thead>
                    <tr>
                        <th>Medicine</th>
                        <th>Branch</th>
                        <th>Batch No.</th>
                        <th>Expiry Date</th>
                        <th class="text-end">Days Left</th>
                        <th class="text-end">Remaining</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var batch in Model)
                    {
                        <tr class="@(batch.IsExpired ? "expired-row" : "expiring-row")">
                            <td class="fw-bold text-dark">@batch.MedicineBrandName</td>
                            <td class="text-muted">@batch.BranchName</td>
                            <td><span class="batch-number">@batch.BatchNumber</span></td>
                            <td class="text-muted">@batch.ExpiryDate.ToString("dd MMM yyyy")</td>
                            <td class="text-end">
                                @if (batch.IsExpired)
                                {
                                    <span class="days-badge expired">EXPIRED</span>
                                }
                                else if (batch.DaysUntilExpiry <= 30)
                                {
                                    <span class="days-badge critical">@batch.DaysUntilExpiry days</span>
                                }
                                else
                                {
                                    <span class="days-badge warning">@batch.DaysUntilExpiry days</span>
                                }
                            </td>
                            <td class="text-end fw-bold">@batch.QuantityRemaining.ToString("N2")</td>
                            <td class="text-end">
                                @if (User.HasClaim("permission", "Inventory.Adjust"))
                                {
                                    <a class="btn-adjust" asp-action="Adjust" asp-route-batchId="@batch.Id">Adjust</a>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>