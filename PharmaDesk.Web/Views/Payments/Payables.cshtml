@model List<SupplierListItemViewModel>
@{
    ViewData["Title"] = "Accounts Payable";
}

@section Breadcrumb {
    <li class="breadcrumb-item active" aria-current="page">Accounts Payable</li>
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0">Accounts Payable</h1>
    <a class="btn btn-outline-secondary" asp-action="Receivables">Accounts Receivable</a>
</div>

<p class="text-muted">Suppliers the pharmacy currently owes money to.</p>

<div class="card-metric p-0">
    <table class="table mb-0">
        <thead>
            <tr>
                <th>Supplier</th>
                <th>Contact</th>
                <th class="text-end">Balance Due</th>
                <th class="text-end">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var supplier in Model)
            {
                <tr>
                    <td>@supplier.Name</td>
                    <td>@supplier.ContactPerson</td>
                    <td class="text-end">@supplier.CurrentBalance.ToString("N2")</td>
                    <td class="text-end">
                        <a class="btn btn-sm btn-outline-secondary" asp-action="SupplierStatement" asp-route-supplierId="@supplier.Id">Statement</a>
                        @if (User.HasClaim("permission", "Payments.Manage"))
                        {
                            <a class="btn btn-sm btn-primary" asp-action="RecordSupplierPayment" asp-route-supplierId="@supplier.Id">Record Payment</a>
                        }
                    </td>
                </tr>
            }
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="4" class="text-center text-muted py-4">No suppliers are currently owed money.</td>
                </tr>
            }
        </tbody>
    </table>
</div>
