@model List<CustomerListItemViewModel>
@{
    ViewData["Title"] = "Accounts Receivable";
}

@section Breadcrumb {
    <li class="breadcrumb-item active" aria-current="page">Accounts Receivable</li>
}

<style>
    .page-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem; flex-wrap: wrap; gap: 10px; }
    .page-title { font-size: 1.5rem; font-weight: 800; color: #0f172a; margin: 0; letter-spacing: -0.5px; }
    
    .btn-secondary-soft {
        background: #ffffff; color: #475569 !important; border: 1px solid #e2e8f0;
        border-radius: 10px; padding: 10px 18px; font-weight: 600; font-size: 0.9rem;
        transition: all 0.2s; text-decoration: none;
    }
    .btn-secondary-soft:hover { background: #f8fafc; border-color: #cbd5e1; color: #0f172a !important; }

    .table-custom-wrapper {
        background: #ffffff; border-radius: 16px; border: 1px solid #e2e8f0;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.02); overflow: hidden;
    }
    .table-custom { width: 100%; margin-bottom: 0; border-collapse: collapse; }
    .table-custom thead { background: #f8fafc; }
    .table-custom th {
        font-size: 0.75rem; font-weight: 700; color: #64748b; text-transform: uppercase;
        letter-spacing: 0.5px; padding: 16px 24px; border-bottom: 1px solid #e2e8f0;
    }
    .table-custom td {
        padding: 16px 24px; border-bottom: 1px solid #f1f5f9; vertical-align: middle;
        font-size: 0.9rem; color: #334155;
    }
    .table-custom tbody tr { transition: background 0.2s; }
    .table-custom tbody tr:hover { background: #f8fafc; }

    .balance-due { font-weight: 800; color: #dc2626; font-size: 1rem; }

    .btn-action {
        padding: 6px 14px; font-size: 0.8rem; font-weight: 600; border-radius: 8px;
        text-decoration: none; transition: all 0.2s; border: 1px solid transparent;
        display: inline-block;
    }
    .btn-view { background: #f1f5f9; color: #475569 !important; }
    .btn-view:hover { background: #e2e8f0; color: #0f172a !important; }
    .btn-pay {
        background: linear-gradient(135deg, #6366f1, #8b5cf6);
        color: #fff !important;
        box-shadow: 0 2px 8px rgba(99, 102, 241, 0.2);
    }
    .btn-pay:hover { transform: translateY(-1px); box-shadow: 0 4px 12px rgba(99, 102, 241, 0.4); }

    .empty-state { padding: 60px 20px; text-align: center; color: #64748b; }
    .empty-state svg { width: 48px; height: 48px; color: #cbd5e1; margin-bottom: 16px; }
    .empty-state h3 { font-size: 1.1rem; font-weight: 700; color: #334155; margin-bottom: 8px; }
</style>

<div class="page-header">
    <div>
        <h1 class="page-title">Accounts Receivable</h1>
        <p class="text-muted small mb-0 mt-1">Customers who currently owe the pharmacy money.</p>
    </div>
    <a class="btn-secondary-soft" asp-action="Payables">💸 Accounts Payable</a>
</div>

<div class="table-custom-wrapper">
    @if (!Model.Any())
    {
        <div class="empty-state">
            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
            <h3>All Clear! 🎉</h3>
            <p>No customers currently have an outstanding balance.</p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table-custom">
                <thead>
                    <tr>
                        <th>Customer</th>
                        <th>Phone</th>
                        <th class="text-end">Balance Due</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var customer in Model)
                    {
                        <tr>
                            <td class="fw-bold text-dark">@customer.Name</td>
                            <td class="text-muted">@customer.Phone</td>
                            <td class="text-end"><span class="balance-due">৳ @customer.CurrentBalance.ToString("N2")</span></td>
                            <td class="text-end">
                                <div class="d-flex justify-content-end gap-2">
                                    <a class="btn-action btn-view" asp-action="CustomerStatement" asp-route-customerId="@customer.Id">Statement</a>
                                    @if (User.HasClaim("permission", "Payments.Manage"))
                                    {
                                        <a class="btn-action btn-pay" asp-action="RecordCustomerPayment" asp-route-customerId="@customer.Id">Receive Payment</a>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>