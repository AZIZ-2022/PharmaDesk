@model List<ManufacturerListItemViewModel>
@{
    ViewData["Title"] = "Manufacturers";
}

@section Breadcrumb {
    <li class="breadcrumb-item"><a asp-controller="Medicines" asp-action="Index">Medicines</a></li>
    <li class="breadcrumb-item active" aria-current="page">Manufacturers</li>
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0">Manufacturers</h1>
    @if (User.HasClaim("permission", "Medicines.Manage"))
    {
        <a class="btn btn-primary" asp-action="Create">New Manufacturer</a>
    }
</div>

<div class="card-metric p-0">
    <table class="table mb-0">
        <thead>
            <tr>
                <th>Name</th>
                <th>Country</th>
                <th>Status</th>
                <th class="text-end">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var manufacturer in Model)
            {
                <tr>
                    <td>@manufacturer.Name</td>
                    <td>@manufacturer.Country</td>
                    <td>
                        @if (manufacturer.IsActive)
                        {
                            <span class="badge text-bg-success">Active</span>
                        }
                        else
                        {
                            <span class="badge text-bg-secondary">Deactivated</span>
                        }
                    </td>
                    <td class="text-end">
                        @if (User.HasClaim("permission", "Medicines.Manage"))
                        {
                            <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@manufacturer.Id">Edit</a>
                            <form asp-action="ToggleActive" asp-route-id="@manufacturer.Id" method="post" class="d-inline">
                                <button type="submit" class="btn btn-sm @(manufacturer.IsActive ? "btn-outline-danger" : "btn-outline-success")">
                                    @(manufacturer.IsActive ? "Deactivate" : "Activate")
                                </button>
                            </form>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
