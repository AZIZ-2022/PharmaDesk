@model List<SupplierListItemViewModel>
@{
    ViewData["Title"] = "Suppliers";
    var searchTerm = ViewData["SearchTerm"] as string;
}

@section Breadcrumb {
    <li class="breadcrumb-item active" aria-current="page">Suppliers</li>
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0">Suppliers</h1>
    @if (User.HasClaim("permission", "Suppliers.Manage"))
    {
        <a class="btn btn-primary" asp-action="Create">New Supplier</a>
    }
</div>

<form method="get" class="mb-3" style="max-width: 400px;">
    <div class="input-group">
        <input type="text" name="q" value="@searchTerm" class="form-control" placeholder="Search by name or phone..." />
        <button type="submit" class="btn btn-outline-secondary">Search</button>
    </div>
</form>

<div class="card-metric p-0">
    <table class="table mb-0">
        <thead>
            <tr>
                <th>Name</th>
                <th>Contact Person</th>
                <th>Phone</th>
                <th>Balance Due</th>
                <th>Status</th>
                <th class="text-end">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var supplier in Model)
            {
                <tr>
                    <td>@supplier.Name</td>
                    <td>@supplier.ContactPerson</td>
                    <td>@supplier.Phone</td>
                    <td>@supplier.CurrentBalance.ToString("N2")</td>
                    <td>
                        @if (supplier.IsActive)
                        {
                            <span class="badge text-bg-success">Active</span>
                        }
                        else
                        {
                            <span class="badge text-bg-secondary">Deactivated</span>
                        }
                    </td>
                    <td class="text-end">
                        @if (User.HasClaim("permission", "Suppliers.Manage"))
                        {
                            <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@supplier.Id">Edit</a>
                            <form asp-action="ToggleActive" asp-route-id="@supplier.Id" method="post" class="d-inline">
                                <button type="submit" class="btn btn-sm @(supplier.IsActive ? "btn-outline-danger" : "btn-outline-success")">
                                    @(supplier.IsActive ? "Deactivate" : "Activate")
                                </button>
                            </form>
                        }
                    </td>
                </tr>
            }
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="6" class="text-center text-muted py-4">No suppliers found.</td>
                </tr>
            }
        </tbody>
    </table>
</div>
