@model SaleDetailsViewModel
@{
    ViewData["Title"] = "Receipt";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>Receipt #@Model.Id</title>
    <style>
        body { font-family: Consolas, 'Courier New', monospace; max-width: 420px; margin: 24px auto; color: #111; }
        h1 { font-size: 1.1rem; text-align: center; margin-bottom: 0; }
        .meta { text-align: center; font-size: 0.85rem; margin-bottom: 1rem; color: #444; }
        table { width: 100%; border-collapse: collapse; font-size: 0.85rem; }
        th, td { padding: 2px 0; text-align: left; }
        th.num, td.num { text-align: right; }
        hr { border: none; border-top: 1px dashed #999; margin: 8px 0; }
        .totals div { display: flex; justify-content: space-between; }
        .totals .grand { font-weight: bold; font-size: 1rem; }
        .no-print { text-align: center; margin-top: 1.5rem; }
        @@media print { .no-print { display: none; } }
    </style>
</head>
<body>
    <h1>PharmaDesk</h1>
    <div class="meta">
        Receipt #@Model.Id<br />
        @Model.SaleDate.ToString("yyyy-MM-dd HH:mm") &middot; @Model.BranchName<br />
        Customer: @Model.CustomerName
    </div>
    <hr />
    <table>
        <thead>
            <tr>
                <th>Item</th>
                <th class="num">Qty</th>
                <th class="num">Price</th>
                <th class="num">Total</th>
                <th class="no-print"></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Items)
            {
                <tr>
                    <td>@item.MedicineBrandName</td>
                    <td class="num">@item.QuantityBaseUnits.ToString("N2")</td>
                    <td class="num">@item.UnitPrice.ToString("N2")</td>
                    <td class="num">@item.LineTotal.ToString("N2")</td>
                    <td class="no-print">
                        @if (User.HasClaim("permission", "Returns.Manage"))
                        {
                            if (item.IsReturned)
                            {
                                <span>Returned</span>
                            }
                            else
                            {
                                <a href="@Url.Action("NewSalesReturn", "Returns", new { saleItemId = item.SaleItemId })">Return</a>
                            }
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
    <hr />
    <div class="totals">
        <div><span>Subtotal</span><span>@Model.SubTotal.ToString("N2")</span></div>
        <div><span>Discount</span><span>@Model.DiscountAmount.ToString("N2")</span></div>
        <div><span>Tax / VAT</span><span>@Model.TaxAmount.ToString("N2")</span></div>
        <div class="grand"><span>Total</span><span>@Model.TotalAmount.ToString("N2")</span></div>
        <div><span>Paid (@Model.PaymentMethod)</span><span>@Model.AmountPaid.ToString("N2")</span></div>
        <div><span>Due</span><span>@Model.Due.ToString("N2")</span></div>
    </div>
    <div class="no-print">
        <button onclick="window.print()">Print</button>
        <a href="@Url.Action("Index", "Sales")">Back to Sales</a>
    </div>
</body>
</html>
