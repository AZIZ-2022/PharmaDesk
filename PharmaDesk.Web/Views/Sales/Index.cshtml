@model List<SaleListItemViewModel>
@{
    ViewData["Title"] = "Sales";
}

@section Breadcrumb {
    <li class="breadcrumb-item active" aria-current="page">Sales</li>
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0">Sales</h1>
    @if (User.HasClaim("permission", "Sales.Manage"))
    {
        <a class="btn btn-primary" asp-action="Pos">New Sale (POS)</a>
    }
</div>

<div class="card-metric p-0">
    <table class="table mb-0">
        <thead>
            <tr>
                <th>Date</th>
                <th>Customer</th>
                <th>Branch</th>
                <th class="text-end">Total</th>
                <th class="text-end">Paid</th>
                <th class="text-end">Due</th>
                <th class="text-end">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var sale in Model)
            {
                <tr>
                    <td>@sale.SaleDate.ToString("yyyy-MM-dd HH:mm")</td>
                    <td>@sale.CustomerName</td>
                    <td>@sale.BranchName</td>
                    <td class="text-end">@sale.TotalAmount.ToString("N2")</td>
                    <td class="text-end">@sale.AmountPaid.ToString("N2")</td>
                    <td class="text-end">@sale.Due.ToString("N2")</td>
                    <td class="text-end">
                        <a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@sale.Id">View</a>
                    </td>
                </tr>
            }
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="7" class="text-center text-muted py-4">No sales recorded yet.</td>
                </tr>
            }
        </tbody>
    </table>
</div>
