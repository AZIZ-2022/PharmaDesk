@model PurchaseFormViewModel
@{
    ViewData["Title"] = "New Purchase";
}

@section Breadcrumb {
    <li class="breadcrumb-item"><a asp-action="Index">Purchases</a></li>
    <li class="breadcrumb-item active" aria-current="page">New</li>
}

<h1 class="h3 mb-4">New Purchase</h1>

<form asp-action="Create" method="post" id="purchaseForm">
    <div asp-validation-summary="ModelOnly" class="text-danger small mb-2"></div>

    <div class="card-metric mb-4">
        <div class="row">
            <div class="col-md-3 mb-3">
                <label asp-for="SupplierId" class="form-label"></label>
                <select asp-for="SupplierId" class="form-select" asp-items="Model.AvailableSuppliers">
                    <option value="">-- Select --</option>
                </select>
                <span asp-validation-for="SupplierId" class="text-danger small"></span>
            </div>
            <div class="col-md-3 mb-3">
                <label asp-for="BranchId" class="form-label"></label>
                <select asp-for="BranchId" class="form-select" asp-items="Model.AvailableBranches">
                    <option value="">-- Select --</option>
                </select>
                <span asp-validation-for="BranchId" class="text-danger small"></span>
            </div>
            <div class="col-md-3 mb-3">
                <label asp-for="PurchaseDate" class="form-label"></label>
                <input asp-for="PurchaseDate" class="form-control" type="date" />
                <span asp-validation-for="PurchaseDate" class="text-danger small"></span>
            </div>
            <div class="col-md-3 mb-3">
                <label asp-for="InvoiceNumber" class="form-label"></label>
                <input asp-for="InvoiceNumber" class="form-control" />
            </div>
        </div>
    </div>

    <div class="card-metric p-0 mb-4">
        <table class="table mb-0" id="itemsTable">
            <thead>
                <tr>
                    <th style="min-width: 200px;">Medicine</th>
                    <th>Batch No.</th>
                    <th>Expiry</th>
                    <th style="width: 120px;">Qty (packs)</th>
                    <th style="width: 140px;">Cost / pack</th>
                    <th style="width: 140px;">Sale price / unit</th>
                    <th style="width: 120px;">Line total</th>
                    <th></th>
                </tr>
            </thead>
            <tbody id="itemsBody"></tbody>
        </table>
        <div class="p-3">
            <button type="button" class="btn btn-outline-primary btn-sm" id="addLineButton">+ Add line</button>
        </div>
    </div>

    <div class="card-metric mb-4" style="max-width: 420px; margin-left: auto;">
        <div class="row mb-2">
            <div class="col-6">Subtotal</div>
            <div class="col-6 text-end" id="subTotalDisplay">0.00</div>
        </div>
        <div class="row mb-2 align-items-center">
            <div class="col-6">
                <label asp-for="DiscountAmount" class="form-label mb-0"></label>
            </div>
            <div class="col-6">
                <input asp-for="DiscountAmount" class="form-control form-control-sm text-end amount-input" type="number" step="0.01" />
            </div>
        </div>
        <div class="row mb-2 align-items-center">
            <div class="col-6">
                <label asp-for="TaxAmount" class="form-label mb-0"></label>
            </div>
            <div class="col-6">
                <input asp-for="TaxAmount" class="form-control form-control-sm text-end amount-input" type="number" step="0.01" />
            </div>
        </div>
        <div class="row mb-2 fw-bold">
            <div class="col-6">Total</div>
            <div class="col-6 text-end" id="totalDisplay">0.00</div>
        </div>
        <div class="row mb-2 align-items-center">
            <div class="col-6">
                <label asp-for="AmountPaid" class="form-label mb-0"></label>
            </div>
            <div class="col-6">
                <input asp-for="AmountPaid" class="form-control form-control-sm text-end amount-input" type="number" step="0.01" />
            </div>
        </div>
        <div class="row fw-bold">
            <div class="col-6">Due to supplier</div>
            <div class="col-6 text-end" id="dueDisplay">0.00</div>
        </div>
    </div>

    <button type="submit" class="btn btn-primary">Save Purchase</button>
    <a class="btn btn-outline-secondary" asp-action="Index">Cancel</a>
</form>

<template id="itemRowTemplate">
    <tr class="purchase-item-row">
        <td>
            <select class="form-select form-select-sm medicine-select" data-field="MedicineId">
                <option value="">-- Select --</option>
                @foreach (var medicine in Model.AvailableMedicines)
                {
                    <option value="@medicine.Id" data-packunit="@medicine.PackUnitName" data-packsize="@medicine.PackSize" data-baseunit="@medicine.BaseUnitName">@medicine.BrandName</option>
                }
            </select>
            <div class="form-text pack-hint"></div>
        </td>
        <td><input type="text" class="form-control form-control-sm" data-field="BatchNumber" /></td>
        <td><input type="date" class="form-control form-control-sm" data-field="ExpiryDate" /></td>
        <td><input type="number" step="0.01" class="form-control form-control-sm qty-input" data-field="QuantityPacks" /></td>
        <td><input type="number" step="0.01" class="form-control form-control-sm cost-input" data-field="PurchasePricePerPack" /></td>
        <td><input type="number" step="0.01" class="form-control form-control-sm" data-field="SellingPricePerBaseUnit" /></td>
        <td class="line-total-display align-middle">0.00</td>
        <td><button type="button" class="btn btn-sm btn-outline-danger remove-row-button">&times;</button></td>
    </tr>
</template>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            var itemsBody = document.getElementById('itemsBody');
            var template = document.getElementById('itemRowTemplate');
            var discountInput = document.querySelector('[name="DiscountAmount"]');
            var taxInput = document.querySelector('[name="TaxAmount"]');
            var paidInput = document.querySelector('[name="AmountPaid"]');

            function reindexAndBind() {
                var rows = itemsBody.querySelectorAll('.purchase-item-row');
                rows.forEach(function (row, index) {
                    row.querySelectorAll('[data-field]').forEach(function (input) {
                        input.name = 'Items[' + index + '].' + input.getAttribute('data-field');
                    });
                });
                recalculate();
            }

            function recalculate() {
                var subTotal = 0;
                itemsBody.querySelectorAll('.purchase-item-row').forEach(function (row) {
                    var qty = parseFloat(row.querySelector('.qty-input').value) || 0;
                    var cost = parseFloat(row.querySelector('.cost-input').value) || 0;
                    var lineTotal = qty * cost;
                    row.querySelector('.line-total-display').textContent = lineTotal.toFixed(2);
                    subTotal += lineTotal;

                    var select = row.querySelector('.medicine-select');
                    var option = select.options[select.selectedIndex];
                    var hint = row.querySelector('.pack-hint');
                    if (option && option.value) {
                        var packSize = parseFloat(option.getAttribute('data-packsize')) || 0;
                        var baseUnits = qty * packSize;
                        hint.textContent = '1 ' + option.getAttribute('data-packunit') + ' = ' + packSize + ' ' + option.getAttribute('data-baseunit') + '(s) → ' + baseUnits.toFixed(2) + ' ' + option.getAttribute('data-baseunit') + '(s) total';
                    } else {
                        hint.textContent = '';
                    }
                });

                var discount = parseFloat(discountInput.value) || 0;
                var tax = parseFloat(taxInput.value) || 0;
                var paid = parseFloat(paidInput.value) || 0;
                var total = subTotal - discount + tax;

                document.getElementById('subTotalDisplay').textContent = subTotal.toFixed(2);
                document.getElementById('totalDisplay').textContent = total.toFixed(2);
                document.getElementById('dueDisplay').textContent = (total - paid).toFixed(2);
            }

            function addRow() {
                var fragment = template.content.cloneNode(true);
                itemsBody.appendChild(fragment);
                var newRow = itemsBody.lastElementChild;
                newRow.querySelectorAll('input, select').forEach(function (el) {
                    el.addEventListener('input', recalculate);
                    el.addEventListener('change', recalculate);
                });
                newRow.querySelector('.remove-row-button').addEventListener('click', function () {
                    newRow.remove();
                    reindexAndBind();
                });
                reindexAndBind();
            }

            document.getElementById('addLineButton').addEventListener('click', addRow);
            [discountInput, taxInput, paidInput].forEach(function (el) {
                el.addEventListener('input', recalculate);
            });

            addRow();
        })();
    </script>
}
