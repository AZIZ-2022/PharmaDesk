@model List<BranchListItemViewModel>
@{
    ViewData["Title"] = "Branches";
}

@section Breadcrumb {
    <li class="breadcrumb-item active" aria-current="page">Branches</li>
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0">Branches</h1>
    @if (User.HasClaim("permission", "Branches.Manage"))
    {
        <a class="btn btn-primary" asp-action="Create">New Branch</a>
    }
</div>

@if (TempData["StatusMessage"] is string status)
{
    <div class="alert alert-warning py-2 small">@status</div>
}

<div class="card-metric p-0">
    <table class="table mb-0">
        <thead>
            <tr>
                <th>Name</th>
                <th>Address</th>
                <th>Phone</th>
                <th>Status</th>
                <th class="text-end">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var branch in Model)
            {
                <tr>
                    <td>
                        @branch.Name
                        @if (branch.IsMainBranch)
                        {
                            <span class="badge text-bg-primary ms-1">Main</span>
                        }
                    </td>
                    <td>@branch.Address</td>
                    <td>@branch.Phone</td>
                    <td>
                        @if (branch.IsActive)
                        {
                            <span class="badge text-bg-success">Active</span>
                        }
                        else
                        {
                            <span class="badge text-bg-secondary">Deactivated</span>
                        }
                    </td>
                    <td class="text-end">
                        @if (User.HasClaim("permission", "Branches.Manage"))
                        {
                            <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@branch.Id">Edit</a>
                            <form asp-action="ToggleActive" asp-route-id="@branch.Id" method="post" class="d-inline">
                                <button type="submit" class="btn btn-sm @(branch.IsActive ? "btn-outline-danger" : "btn-outline-success")">
                                    @(branch.IsActive ? "Deactivate" : "Activate")
                                </button>
                            </form>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
