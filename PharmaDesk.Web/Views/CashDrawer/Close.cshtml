@model CashDrawerCloseFormViewModel
@{
    ViewData["Title"] = "Close Cash Drawer";
}

@section Breadcrumb {
    <li class="breadcrumb-item"><a asp-action="Index" class="text-decoration-none text-muted">Cash Drawer</a></li>
    <li class="breadcrumb-item active" aria-current="page">Close</li>
}

<style>
    .form-card {
        background: #ffffff; border-radius: 16px; border: 1px solid #e2e8f0;
        box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.05); padding: 32px;
        max-width: 640px; margin-top: 10px;
    }
    .form-label { font-size: 0.85rem; font-weight: 700; color: #334155; margin-bottom: 6px; }
    .form-control {
        border-radius: 10px; border: 1.5px solid #e2e8f0; padding: 10px 14px;
        font-size: 0.95rem; transition: all 0.2s;
    }
    .form-control:focus {
        border-color: #8b5cf6; box-shadow: 0 0 0 4px rgba(139, 92, 246, 0.1);
    }
    
    .summary-card {
        background: linear-gradient(135deg, #f8fafc, #f1f5f9);
        border: 1px solid #e2e8f0; border-radius: 12px;
        padding: 20px; margin-bottom: 24px;
    }
    .summary-row {
        display: flex; justify-content: space-between; align-items: center;
        padding: 10px 0; border-bottom: 1px dashed #e2e8f0;
        font-size: 0.9rem;
    }
    .summary-row:last-child { border-bottom: none; padding-bottom: 0; }
    .summary-row .label { color: #64748b; font-weight: 500; }
    .summary-row .value { font-weight: 700; color: #0f172a; }
    .summary-row.highlight { background: #eff6ff; margin: 0 -20px; padding: 12px 20px; border-radius: 8px; }
    .summary-row.highlight .value { color: #2563eb; font-size: 1.05rem; }

    .warning-banner {
        background: linear-gradient(135deg, #fffbeb, #fef3c7);
        border: 1px solid #fde68a; border-radius: 12px;
        padding: 14px 18px; margin-bottom: 24px;
        display: flex; align-items: flex-start; gap: 10px;
        color: #92400e; font-size: 0.85rem;
    }

    .btn-save {
        background: linear-gradient(135deg, #ef4444, #dc2626); color: #fff;
        border: none; border-radius: 10px; padding: 10px 24px; font-weight: 600;
        box-shadow: 0 4px 12px rgba(239, 68, 68, 0.3); transition: all 0.2s;
    }
    .btn-save:hover { transform: translateY(-2px); box-shadow: 0 6px 16px rgba(239, 68, 68, 0.4); color: #fff; }
    .btn-cancel {
        background: #f1f5f9; color: #475569; border: none; border-radius: 10px;
        padding: 10px 24px; font-weight: 600; transition: all 0.2s;
    }
    .btn-cancel:hover { background: #e2e8f0; color: #0f172a; }
</style>

<div class="mb-4">
    <h1 class="h3 fw-bold mb-1" style="color:#0f172a;">Close Cash Drawer</h1>
    <p class="text-muted small mb-0">Closing session for <strong>@Model.BranchName</strong></p>
</div>

<div class="form-card">
    <div class="summary-card">
        <div class="summary-row">
            <span class="label">Session Date</span>
            <span class="value">@Model.SessionDate.ToString("dd MMM yyyy")</span>
        </div>
        <div class="summary-row">
            <span class="label">Opening Cash</span>
            <span class="value">৳ @Model.OpeningCashAmount.ToString("N2")</span>
        </div>
        <div class="summary-row highlight">
            <span class="label">Expected Closing Cash</span>
            <span class="value">৳ @Model.ExpectedClosingCashAmount.ToString("N2")</span>
        </div>
    </div>

    <div class="warning-banner">
        <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path></svg>
        <div>
            This expected figure does not include cash refunds from sales/purchase returns (those don't record a cash/non-cash settlement method).
        </div>
    </div>

    <form asp-action="Close" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger small mb-3 p-2 bg-danger-subtle rounded"></div>
        <input type="hidden" asp-for="SessionId" />

        <div class="mb-3">
            <label asp-for="ClosingCashAmount" class="form-label"></label>
            <input asp-for="ClosingCashAmount" class="form-control" type="number" step="0.01" placeholder="0.00" />
            <span asp-validation-for="ClosingCashAmount" class="text-danger small"></span>
            <div class="form-text small text-muted mt-1">Enter the actual cash counted in the drawer.</div>
        </div>

        <div class="mb-4">
            <label asp-for="Notes" class="form-label"></label>
            <textarea asp-for="Notes" class="form-control" rows="2" placeholder="Any discrepancy notes..."></textarea>
        </div>

        <div class="d-flex gap-2 pt-3 border-top">
            <button type="submit" class="btn btn-save">Close Session</button>
            <a class="btn btn-cancel" asp-action="Index">Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}