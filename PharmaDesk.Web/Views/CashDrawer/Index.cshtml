@model CashDrawerIndexViewModel
@{
    ViewData["Title"] = "Cash Drawer";
}

@section Breadcrumb {
    <li class="breadcrumb-item active" aria-current="page">Cash Drawer</li>
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0">Cash Drawer</h1>
    @if (User.HasClaim("permission", "CashDrawer.Manage"))
    {
        <a class="btn btn-primary" asp-action="Open">Open a Session</a>
    }
</div>

<h2 class="h5 mb-3">Branch Status</h2>
<div class="card-metric p-0 mb-4">
    <table class="table mb-0">
        <thead>
            <tr>
                <th>Branch</th>
                <th>Status</th>
                <th class="text-end">Opening Cash</th>
                <th>Opened At</th>
                <th class="text-end">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var status in Model.BranchStatuses)
            {
                <tr>
                    <td>@status.BranchName</td>
                    <td>
                        @if (status.IsOpen)
                        {
                            <span class="badge text-bg-success">Open</span>
                        }
                        else
                        {
                            <span class="badge text-bg-secondary">Closed</span>
                        }
                    </td>
                    <td class="text-end">@(status.OpeningCashAmount?.ToString("N2"))</td>
                    <td>@(status.OpenedAtUtc?.ToString("yyyy-MM-dd HH:mm"))</td>
                    <td class="text-end">
                        @if (status.IsOpen && User.HasClaim("permission", "CashDrawer.Manage"))
                        {
                            <a class="btn btn-sm btn-outline-secondary" asp-action="Close" asp-route-sessionId="@status.OpenSessionId">Close Session</a>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<h2 class="h5 mb-3">Recent History</h2>
<div class="card-metric p-0">
    <table class="table mb-0">
        <thead>
            <tr>
                <th>Branch</th>
                <th>Date</th>
                <th class="text-end">Opening</th>
                <th class="text-end">Expected</th>
                <th class="text-end">Actual</th>
                <th class="text-end">Variance</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var h in Model.History)
            {
                <tr class="@(h.Variance.HasValue && h.Variance.Value != 0 ? "table-warning" : "")">
                    <td>@h.BranchName</td>
                    <td>@h.SessionDate.ToString("yyyy-MM-dd")</td>
                    <td class="text-end">@h.OpeningCashAmount.ToString("N2")</td>
                    <td class="text-end">@(h.ExpectedClosingCashAmount?.ToString("N2"))</td>
                    <td class="text-end">@(h.ClosingCashAmount?.ToString("N2"))</td>
                    <td class="text-end">@(h.Variance?.ToString("N2"))</td>
                </tr>
            }
            @if (!Model.History.Any())
            {
                <tr>
                    <td colspan="6" class="text-center text-muted py-4">No closed sessions yet.</td>
                </tr>
            }
        </tbody>
    </table>
</div>
