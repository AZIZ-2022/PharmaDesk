@model CashDrawerIndexViewModel
@{
    ViewData["Title"] = "Cash Drawer";
}

@section Breadcrumb {
    <li class="breadcrumb-item active" aria-current="page">Cash Drawer</li>
}

<style>
    .page-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem; flex-wrap: wrap; gap: 10px; }
    .page-title { font-size: 1.5rem; font-weight: 800; color: #0f172a; margin: 0; letter-spacing: -0.5px; }
    .section-title { font-size: 1.1rem; font-weight: 700; color: #0f172a; margin: 0 0 12px 0; }
    
    .btn-premium {
        background: linear-gradient(135deg, #6366f1, #8b5cf6);
        color: #fff !important; border: none; border-radius: 10px; padding: 10px 20px;
        font-weight: 600; font-size: 0.9rem; box-shadow: 0 4px 12px rgba(99, 102, 241, 0.3);
        transition: all 0.2s;
    }
    .btn-premium:hover { transform: translateY(-2px); box-shadow: 0 6px 16px rgba(99, 102, 241, 0.4); }

    .table-custom-wrapper {
        background: #ffffff; border-radius: 16px; border: 1px solid #e2e8f0;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.02); overflow: hidden;
        margin-bottom: 2rem;
    }
    .table-custom { width: 100%; margin-bottom: 0; border-collapse: collapse; }
    .table-custom thead { background: #f8fafc; }
    .table-custom th {
        font-size: 0.75rem; font-weight: 700; color: #64748b; text-transform: uppercase;
        letter-spacing: 0.5px; padding: 14px 20px; border-bottom: 1px solid #e2e8f0;
    }
    .table-custom td {
        padding: 14px 20px; border-bottom: 1px solid #f1f5f9; vertical-align: middle;
        font-size: 0.9rem; color: #334155;
    }
    .table-custom tbody tr { transition: background 0.2s; }
    .table-custom tbody tr:hover { background: #f8fafc; }

    .badge-status {
        padding: 6px 12px; border-radius: 20px; font-size: 0.75rem; font-weight: 600;
        display: inline-flex; align-items: center; gap: 6px;
    }
    .badge-status.open { background: #ecfdf5; color: #059669; border: 1px solid #a7f3d0; }
    .badge-status.closed { background: #f1f5f9; color: #64748b; border: 1px solid #e2e8f0; }
    .badge-status::before { content: ''; width: 6px; height: 6px; border-radius: 50%; background: currentColor; }

    .variance-zero { color: #059669; font-weight: 700; }
    .variance-positive { color: #d97706; font-weight: 700; }
    .variance-negative { color: #dc2626; font-weight: 700; }

    .btn-action {
        padding: 6px 14px; font-size: 0.8rem; font-weight: 600; border-radius: 8px;
        text-decoration: none; transition: all 0.2s;
        background: #fef2f2; color: #dc2626 !important; border: 1px solid #fecaca;
    }
    .btn-action:hover { background: #fee2e2; color: #991b1b !important; }

    .empty-state { padding: 40px 20px; text-align: center; color: #64748b; }
</style>

<div class="page-header">
    <div>
        <h1 class="page-title">Cash Drawer</h1>
        <p class="text-muted small mb-0 mt-1">Track daily cash sessions per branch.</p>
    </div>
    @if (User.HasClaim("permission", "CashDrawer.Manage"))
    {
        <a class="btn-premium" asp-action="Open">+ Open New Session</a>
    }
</div>

<h2 class="section-title">🏢 Branch Status</h2>
<div class="table-custom-wrapper">
    <div class="table-responsive">
        <table class="table-custom">
            <thead>
                <tr>
                    <th>Branch</th>
                    <th>Status</th>
                    <th class="text-end">Opening Cash</th>
                    <th>Opened At</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var status in Model.BranchStatuses)
                {
                    <tr>
                        <td class="fw-bold text-dark">@status.BranchName</td>
                        <td>
                            @if (status.IsOpen)
                            {
                                <span class="badge-status open">Open</span>
                            }
                            else
                            {
                                <span class="badge-status closed">Closed</span>
                            }
                        </td>
                        <td class="text-end fw-semibold">@(status.OpeningCashAmount?.ToString("N2") ?? "—")</td>
                        <td class="text-muted">@(status.OpenedAtUtc?.ToString("dd MMM yyyy, HH:mm") ?? "—")</td>
                        <td class="text-end">
                            @if (status.IsOpen && User.HasClaim("permission", "CashDrawer.Manage"))
                            {
                                <a class="btn-action" asp-action="Close" asp-route-sessionId="@status.OpenSessionId">Close Session</a>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<h2 class="section-title">📊 Recent History</h2>
<div class="table-custom-wrapper">
    @if (!Model.History.Any())
    {
        <div class="empty-state">No closed sessions yet.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table-custom">
                <thead>
                    <tr>
                        <th>Branch</th>
                        <th>Date</th>
                        <th class="text-end">Opening</th>
                        <th class="text-end">Expected</th>
                        <th class="text-end">Actual</th>
                        <th class="text-end">Variance</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var h in Model.History)
                    {
                        <tr>
                            <td class="fw-bold text-dark">@h.BranchName</td>
                            <td class="text-muted">@h.SessionDate.ToString("dd MMM yyyy")</td>
                            <td class="text-end">৳ @h.OpeningCashAmount.ToString("N2")</td>
                            <td class="text-end">৳ @(h.ExpectedClosingCashAmount?.ToString("N2") ?? "—")</td>
                            <td class="text-end">৳ @(h.ClosingCashAmount?.ToString("N2") ?? "—")</td>
                            <td class="text-end">
                                @if (h.Variance == 0)
                                {
                                    <span class="variance-zero">✓ ৳ 0.00</span>
                                }
                                else if (h.Variance > 0)
                                {
                                    <span class="variance-positive">+ ৳ @h.Variance.Value.ToString("N2")</span>
                                }
                                else if (h.Variance < 0)
                                {
                                    <span class="variance-negative">- ৳ @Math.Abs(h.Variance.Value).ToString("N2")</span>
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>