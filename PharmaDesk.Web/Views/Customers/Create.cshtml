@model CustomerFormViewModel
@{
    ViewData["Title"] = "New Customer";
}

@section Breadcrumb {
    <li class="breadcrumb-item"><a asp-action="Index">Customers</a></li>
    <li class="breadcrumb-item active" aria-current="page">New</li>
}

<h1 class="h3 mb-4">New Customer</h1>

<div class="card-metric" style="max-width: 640px;">
    <form asp-action="Create" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger small mb-2"></div>

        <div class="mb-3">
            <label asp-for="Name" class="form-label"></label>
            <input asp-for="Name" class="form-control" />
            <span asp-validation-for="Name" class="text-danger small"></span>
        </div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label asp-for="Phone" class="form-label"></label>
                <input asp-for="Phone" class="form-control" />
            </div>
            <div class="col-md-6 mb-3">
                <label asp-for="Email" class="form-label"></label>
                <input asp-for="Email" class="form-control" />
            </div>
        </div>

        <div class="mb-3">
            <label asp-for="Address" class="form-label"></label>
            <textarea asp-for="Address" class="form-control" rows="2"></textarea>
        </div>

        <div class="row">
            <div class="col-md-4 mb-3 d-flex align-items-end">
                <div class="form-check">
                    <input asp-for="IsCreditEligible" class="form-check-input" />
                    <label asp-for="IsCreditEligible" class="form-check-label"></label>
                </div>
            </div>
            <div class="col-md-4 mb-3">
                <label asp-for="CreditLimit" class="form-label"></label>
                <input asp-for="CreditLimit" class="form-control" type="number" step="0.01" />
            </div>
            <div class="col-md-4 mb-3">
                <label asp-for="OpeningBalance" class="form-label"></label>
                <input asp-for="OpeningBalance" class="form-control" type="number" step="0.01" />
                <span asp-validation-for="OpeningBalance" class="text-danger small"></span>
            </div>
        </div>

        <button type="submit" class="btn btn-primary">Create</button>
        <a class="btn btn-outline-secondary" asp-action="Index">Cancel</a>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
