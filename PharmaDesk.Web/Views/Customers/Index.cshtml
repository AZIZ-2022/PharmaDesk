@model List<CustomerListItemViewModel>
@{
    ViewData["Title"] = "Customers";
    var searchTerm = ViewData["SearchTerm"] as string;
}

@section Breadcrumb {
    <li class="breadcrumb-item active" aria-current="page">Customers</li>
}

<style>
    .page-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem; flex-wrap: wrap; gap: 10px; }
    .page-title { font-size: 1.5rem; font-weight: 800; color: #0f172a; margin: 0; letter-spacing: -0.5px; }
    
    .btn-premium {
        background: linear-gradient(135deg, #6366f1, #8b5cf6);
        color: #fff !important; border: none; border-radius: 10px; padding: 10px 20px;
        font-weight: 600; font-size: 0.9rem; box-shadow: 0 4px 12px rgba(99, 102, 241, 0.3);
        transition: all 0.2s;
    }
    .btn-premium:hover { transform: translateY(-2px); box-shadow: 0 6px 16px rgba(99, 102, 241, 0.4); }

    .search-bar { max-width: 400px; width: 100%; margin-bottom: 1.5rem; }
    .search-bar .form-control {
        border-radius: 10px 0 0 10px; border: 1.5px solid #e2e8f0; padding: 10px 16px;
        border-right: none;
    }
    .search-bar .form-control:focus { border-color: #8b5cf6; box-shadow: none; }
    .search-bar .btn {
        border-radius: 0 10px 10px 0; border: 1.5px solid #e2e8f0; border-left: none;
        background: #f8fafc; color: #475569; font-weight: 600;
    }
    .search-bar .btn:hover { background: #e2e8f0; }

    .table-custom-wrapper {
        background: #ffffff; border-radius: 16px; border: 1px solid #e2e8f0;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.02); overflow: hidden;
    }
    .table-custom { width: 100%; margin-bottom: 0; border-collapse: collapse; }
    .table-custom thead { background: #f8fafc; }
    .table-custom th {
        font-size: 0.75rem; font-weight: 700; color: #64748b; text-transform: uppercase;
        letter-spacing: 0.5px; padding: 16px 24px; border-bottom: 1px solid #e2e8f0;
    }
    .table-custom td {
        padding: 16px 24px; border-bottom: 1px solid #f1f5f9; vertical-align: middle;
        font-size: 0.9rem; color: #334155;
    }
    .table-custom tbody tr { transition: background 0.2s; }
    .table-custom tbody tr:hover { background: #f8fafc; }

    .badge-status {
        padding: 6px 12px; border-radius: 20px; font-size: 0.75rem; font-weight: 600;
        display: inline-flex; align-items: center; gap: 6px;
    }
    .badge-status.active { background: #ecfdf5; color: #059669; border: 1px solid #a7f3d0; }
    .badge-status.inactive { background: #f1f5f9; color: #64748b; border: 1px solid #e2e8f0; }
    .badge-status::before { content: ''; width: 6px; height: 6px; border-radius: 50%; background: currentColor; }

    .badge-default {
        background: linear-gradient(135deg, #e0e7ff, #c7d2fe); color: #4338ca;
        padding: 4px 10px; border-radius: 8px; font-size: 0.7rem; font-weight: 700;
        text-transform: uppercase; letter-spacing: 0.5px; margin-left: 8px;
        display: inline-flex; align-items: center; gap: 4px;
    }

    .badge-credit-yes {
        background: #dbeafe; color: #1e40af; border: 1px solid #bfdbfe;
        padding: 4px 10px; border-radius: 8px; font-size: 0.75rem; font-weight: 600;
    }
    .badge-credit-no {
        background: #f1f5f9; color: #94a3b8; border: 1px solid #e2e8f0;
        padding: 4px 10px; border-radius: 8px; font-size: 0.75rem; font-weight: 600;
    }

    .balance-due { font-weight: 700; }
    .balance-due.has-due { color: #dc2626; }
    .balance-due.no-due { color: #059669; }

    .btn-action {
        padding: 6px 12px; font-size: 0.8rem; font-weight: 600; border-radius: 8px;
        text-decoration: none; transition: all 0.2s; border: 1px solid transparent;
    }
    .btn-edit { background: #f1f5f9; color: #475569 !important; }
    .btn-edit:hover { background: #e2e8f0; color: #0f172a !important; }
    .btn-danger-soft { background: #fef2f2; color: #dc2626 !important; }
    .btn-danger-soft:hover { background: #fee2e2; }
    .btn-success-soft { background: #ecfdf5; color: #059669 !important; }
    .btn-success-soft:hover { background: #d1fae5; }

    .empty-state { padding: 60px 20px; text-align: center; color: #64748b; }
    .empty-state svg { width: 48px; height: 48px; color: #cbd5e1; margin-bottom: 16px; }
    .empty-state h3 { font-size: 1.1rem; font-weight: 700; color: #334155; margin-bottom: 8px; }
</style>

<div class="page-header">
    <div>
        <h1 class="page-title">Customers</h1>
        <p class="text-muted small mb-0 mt-1">Manage your pharmacy customers and credit accounts.</p>
    </div>
    @if (User.HasClaim("permission", "Customers.Manage"))
    {
        <a class="btn-premium" asp-action="Create">+ New Customer</a>
    }
</div>

@if (TempData["StatusMessage"] is string status)
{
    <div class="alert alert-warning d-flex align-items-center gap-2 py-3 px-3 rounded-3 border-0 shadow-sm mb-4" style="background:#fffbeb; color:#b45309;">
        <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path></svg>
        <span class="small fw-medium">@status</span>
    </div>
}

<form method="get" class="search-bar">
    <div class="input-group">
        <input type="text" name="q" value="@searchTerm" class="form-control" placeholder="🔍 Search by name or phone..." />
        <button type="submit" class="btn">Search</button>
    </div>
</form>

<div class="table-custom-wrapper">
    @if (!Model.Any())
    {
        <div class="empty-state">
            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path></svg>
            <h3>No Customers Found</h3>
            <p>Get started by adding your first customer.</p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table-custom">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Phone</th>
                        <th>Credit Eligible</th>
                        <th>Balance Due</th>
                        <th>Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var customer in Model)
                    {
                        <tr>
                            <td>
                                <span class="fw-bold text-dark">@customer.Name</span>
                                @if (customer.IsWalkInDefault)
                                {
                                    <span class="badge-default">⭐ Default</span>
                                }
                            </td>
                            <td class="text-muted">@customer.Phone</td>
                            <td>
                                @if (customer.IsCreditEligible)
                                {
                                    <span class="badge-credit-yes">✓ Yes</span>
                                }
                                else
                                {
                                    <span class="badge-credit-no">— No</span>
                                }
                            </td>
                            <td>
                                @if (customer.CurrentBalance > 0)
                                {
                                    <span class="balance-due has-due">৳ @customer.CurrentBalance.ToString("N2")</span>
                                }
                                else
                                {
                                    <span class="balance-due no-due">৳ @customer.CurrentBalance.ToString("N2")</span>
                                }
                            </td>
                            <td>
                                @if (customer.IsActive)
                                {
                                    <span class="badge-status active">Active</span>
                                }
                                else
                                {
                                    <span class="badge-status inactive">Deactivated</span>
                                }
                            </td>
                            <td class="text-end">
                                <div class="d-flex justify-content-end gap-2">
                                    @if (User.HasClaim("permission", "Customers.Manage"))
                                    {
                                        <a class="btn-action btn-edit" asp-action="Edit" asp-route-id="@customer.Id">Edit</a>
                                        @if (!customer.IsWalkInDefault)
                                        {
                                            <form asp-action="ToggleActive" asp-route-id="@customer.Id" method="post" class="d-inline m-0">
                                                <button type="submit" class="btn-action @(customer.IsActive ? "btn-danger-soft" : "btn-success-soft")">
                                                    @(customer.IsActive ? "Deactivate" : "Activate")
                                                </button>
                                            </form>
                                        }
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>