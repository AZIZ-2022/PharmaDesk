@model List<CustomerListItemViewModel>
@{
    ViewData["Title"] = "Customers";
    var searchTerm = ViewData["SearchTerm"] as string;
}

@section Breadcrumb {
    <li class="breadcrumb-item active" aria-current="page">Customers</li>
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0">Customers</h1>
    @if (User.HasClaim("permission", "Customers.Manage"))
    {
        <a class="btn btn-primary" asp-action="Create">New Customer</a>
    }
</div>

@if (TempData["StatusMessage"] is string status)
{
    <div class="alert alert-warning py-2 small">@status</div>
}

<form method="get" class="mb-3" style="max-width: 400px;">
    <div class="input-group">
        <input type="text" name="q" value="@searchTerm" class="form-control" placeholder="Search by name or phone..." />
        <button type="submit" class="btn btn-outline-secondary">Search</button>
    </div>
</form>

<div class="card-metric p-0">
    <table class="table mb-0">
        <thead>
            <tr>
                <th>Name</th>
                <th>Phone</th>
                <th>Credit Eligible</th>
                <th>Balance Due</th>
                <th>Status</th>
                <th class="text-end">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var customer in Model)
            {
                <tr>
                    <td>
                        @customer.Name
                        @if (customer.IsWalkInDefault)
                        {
                            <span class="badge text-bg-primary ms-1">Default</span>
                        }
                    </td>
                    <td>@customer.Phone</td>
                    <td>@(customer.IsCreditEligible ? "Yes" : "No")</td>
                    <td>@customer.CurrentBalance.ToString("N2")</td>
                    <td>
                        @if (customer.IsActive)
                        {
                            <span class="badge text-bg-success">Active</span>
                        }
                        else
                        {
                            <span class="badge text-bg-secondary">Deactivated</span>
                        }
                    </td>
                    <td class="text-end">
                        @if (User.HasClaim("permission", "Customers.Manage"))
                        {
                            <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@customer.Id">Edit</a>
                            @if (!customer.IsWalkInDefault)
                            {
                                <form asp-action="ToggleActive" asp-route-id="@customer.Id" method="post" class="d-inline">
                                    <button type="submit" class="btn btn-sm @(customer.IsActive ? "btn-outline-danger" : "btn-outline-success")">
                                        @(customer.IsActive ? "Deactivate" : "Activate")
                                    </button>
                                </form>
                            }
                        }
                    </td>
                </tr>
            }
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="6" class="text-center text-muted py-4">No customers found.</td>
                </tr>
            }
        </tbody>
    </table>
</div>
