@model PurchaseReturnFormViewModel
@{
    ViewData["Title"] = "New Purchase Return";
}

@section Breadcrumb {
    <li class="breadcrumb-item"><a asp-controller="Purchases" asp-action="Details" asp-route-id="@Model.PurchaseId">Purchase #@Model.PurchaseId</a></li>
    <li class="breadcrumb-item active" aria-current="page">Return</li>
}

<h1 class="h3 mb-4">Return Stock to Supplier</h1>

<div class="card-metric" style="max-width: 560px;">
    <p>
        <strong>@Model.MedicineBrandName</strong> &mdash; Batch @Model.BatchNumber<br />
        Currently in stock: @Model.CurrentQuantityRemaining.ToString("N2") @@ @Model.CostPerBaseUnit.ToString("N2") cost/unit
    </p>

    <form asp-action="NewPurchaseReturn" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger small mb-2"></div>
        <input type="hidden" asp-for="MedicineBatchId" />
        <input type="hidden" asp-for="PurchaseId" />
        <input type="hidden" asp-for="MedicineBrandName" />
        <input type="hidden" asp-for="BatchNumber" />
        <input type="hidden" asp-for="CurrentQuantityRemaining" />
        <input type="hidden" asp-for="CostPerBaseUnit" />

        <div class="mb-3">
            <label asp-for="QuantityReturned" class="form-label"></label>
            <input asp-for="QuantityReturned" class="form-control" type="number" step="0.01" />
            <span asp-validation-for="QuantityReturned" class="text-danger small"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Reason" class="form-label"></label>
            <select asp-for="Reason" class="form-select">
                <option value="">-- Select --</option>
                <option value="Expired">Expired</option>
                <option value="Damaged">Damaged</option>
                <option value="Wrong Item">Wrong Item</option>
                <option value="Other">Other</option>
            </select>
            <span asp-validation-for="Reason" class="text-danger small"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Notes" class="form-label"></label>
            <textarea asp-for="Notes" class="form-control" rows="2"></textarea>
        </div>

        <button type="submit" class="btn btn-primary">Save Return</button>
        <a class="btn btn-outline-secondary" asp-controller="Purchases" asp-action="Details" asp-route-id="@Model.PurchaseId">Cancel</a>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
