@model List<SalesReturnListItemViewModel>
@{
    ViewData["Title"] = "Sales Returns";
}

@section Breadcrumb {
    <li class="breadcrumb-item active" aria-current="page">Sales Returns</li>
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0">Sales Returns</h1>
    <a class="btn btn-outline-secondary" asp-action="PurchaseReturns">Purchase Returns</a>
</div>

<div class="card-metric p-0">
    <table class="table mb-0">
        <thead>
            <tr>
                <th>Date</th>
                <th>Sale #</th>
                <th>Customer</th>
                <th>Medicine</th>
                <th class="text-end">Qty</th>
                <th class="text-end">Return Amount</th>
                <th>Restocked</th>
                <th>Reason</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var r in Model)
            {
                <tr>
                    <td>@r.ReturnedAtUtc.ToString("yyyy-MM-dd HH:mm")</td>
                    <td><a asp-controller="Sales" asp-action="Details" asp-route-id="@r.SaleId">#@r.SaleId</a></td>
                    <td>@r.CustomerName</td>
                    <td>@r.MedicineBrandName</td>
                    <td class="text-end">@r.QuantityReturned.ToString("N2")</td>
                    <td class="text-end">@r.ReturnAmount.ToString("N2")</td>
                    <td>@(r.IsRestocked ? "Yes" : "No")</td>
                    <td>@r.Reason</td>
                </tr>
            }
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="8" class="text-center text-muted py-4">No sales returns recorded yet.</td>
                </tr>
            }
        </tbody>
    </table>
</div>
