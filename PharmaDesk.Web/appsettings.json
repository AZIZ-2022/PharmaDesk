{
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=PharmaDesk;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "BackupSettings": {
    "DirectoryPath": "C:\\PharmaDeskBackups",
    "RetentionCount": 14,
    "DailyBackupHourUtc": 2
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/pharmadesk-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "AllowedHosts": "*"
}
